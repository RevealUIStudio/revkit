# Force LF line endings for shell scripts (sourced by WSL bash)
*.sh text eol=lf

# PowerShell scripts use CRLF (Windows native)
*.ps1 text eol=crlf
*.psd1 text eol=crlf
*.psm1 text eol=crlf

# Config files use LF (consumed by WSL/Unix tools)
shell/config/* text eol=lf

# Git hooks are extensionless and run by bash — force LF so they survive a
# checkout with autocrlf=true (Windows), where CRLF would break the shebang.
git-hooks/* text eol=lf
