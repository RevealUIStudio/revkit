[core]
	fsmonitor = false
	untrackedCache = false
	autocrlf = input
[user]
	name = {{GIT_NAME}}
	email = {{GIT_EMAIL}}
[credential "https://github.com"]
	helper =
	helper = !/home/{{USERNAME}}/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/home/{{USERNAME}}/bin/gh auth git-credential
[init]
	defaultBranch = main
