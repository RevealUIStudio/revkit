[core]
	fsmonitor = false
	untrackedCache = false
	autocrlf = input
# Per-user identity is machine-local (never committed); bootstrap seeds it.
[include]
	path = ~/.config/revkit/identity.gitconfig
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[init]
	defaultBranch = main
